{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kisses-app-sync",
  "main": "src/index.js",
  "compatibility_date": "2024-09-23",
  "durable_objects": {
    "bindings": [
      { "name": "KISS_ROOM", "class_name": "KissRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["KissRoom"] }
  ]
}
